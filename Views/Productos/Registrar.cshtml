@model Tarea3VRD.Models.Producto

@{
    ViewData["Title"] = "Registrar Producto";
}

<h2>Registrar Producto</h2>

<form asp-action="Registrar" method="post">
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="form-group">
        <label>Precio</label>
        <input asp-for="Precio" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group">
        <label>Stock</label>
        <input asp-for="Stock" type="number" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success mt-3">Guardar</button>
</form>
